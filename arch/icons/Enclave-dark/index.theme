[Icon Theme]
Name=Enclave Icons Dark
Comment=Enclave OS icons (dark). Shares Enclave's icons (scalable is a link to ../Enclave/scalable, made by the build); dark symbolic icons from Papirus-Dark.
Inherits=hicolor,Papirus-Dark,Adwaita
Example=folder
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes

[scalable/apps]
Context=Applications
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=8
MaxSize=512
Type=Scalable
