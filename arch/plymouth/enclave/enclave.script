# Enclave OS — boot splash (Plymouth script theme), Enclave Ember.
#
# Obsidian screen, the Enclave mark fading in at the centre, and a slim track
# underneath with an ember segment gliding along it while the system starts.
# Disk-encryption passphrases get a calm prompt with dots; boot messages show
# quietly at the bottom. Images are rendered at build time (scripts/build-iso.sh).

# Obsidian #101114
Window.SetBackgroundTopColor(0.063, 0.067, 0.078);
Window.SetBackgroundBottomColor(0.063, 0.067, 0.078);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();
screen.x = Window.GetX();
screen.y = Window.GetY();
centre.x = screen.x + screen.w / 2;
centre.y = screen.y + screen.h / 2;

# ---- the mark ----
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(centre.x - logo.image.GetWidth() / 2);
logo.sprite.SetY(centre.y - logo.image.GetHeight() / 2 - 36);
logo.sprite.SetOpacity(0);

# ---- the track and its gliding ember segment ----
bar.w = 168;
bar.h = 3;
bar.x = centre.x - bar.w / 2;
bar.y = centre.y + logo.image.GetHeight() / 2 + 18;
track.image = Image("track.png").Scale(bar.w, bar.h);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(bar.x, bar.y, 1);
track.sprite.SetOpacity(0);

seg.w = 48;
seg.image = Image("fill.png").Scale(seg.w, bar.h);
seg.sprite = Sprite(seg.image);
seg.sprite.SetPosition(bar.x, bar.y, 2);
seg.sprite.SetOpacity(0);

fade = 0;
tick = 0;
asking = 0;

fun refresh_callback ()
{
    global.tick = tick + 1;
    if (fade < 1) global.fade = fade + 0.03;
    if (fade > 1) global.fade = 1;
    logo.sprite.SetOpacity(fade);

    show = fade;
    if (asking) show = 0;
    track.sprite.SetOpacity(show * 0.9);

    # ease back and forth along the track (a smooth sine glide)
    t = (Math.Sin(tick / 22) + 1) / 2;
    seg.sprite.SetX(bar.x + t * (bar.w - seg.w));
    seg.sprite.SetOpacity(show);
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- passphrase prompt (encrypted disks) ----
prompt.sprite = Sprite();
dot.image = Image("dot.png");

fun display_password_callback (prompt_text, bullets)
{
    global.asking = 1;
    label = prompt_text;
    if (label == "") label = "Enter your passphrase to unlock this disk";
    global.prompt.image = Image.Text(label, 0.96, 0.95, 0.94, 1, "Sans 11");
    prompt.sprite.SetImage(global.prompt.image);
    prompt.sprite.SetPosition(centre.x - global.prompt.image.GetWidth() / 2, bar.y - 6, 3);
    prompt.sprite.SetOpacity(1);

    gap = 14;
    total = bullets * gap;
    for (i = 0; i < bullets || dots[i]; i++)
    {
        if (!global.dots[i]) global.dots[i] = Sprite(dot.image);
        global.dots[i].SetPosition(centre.x - total / 2 + i * gap, bar.y + 26, 3);
        if (i < bullets) global.dots[i].SetOpacity(1);
        else global.dots[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback ()
{
    global.asking = 0;
    prompt.sprite.SetOpacity(0);
    for (i = 0; dots[i]; i++) dots[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---- quiet status line at the bottom (e.g. "Checking disks…") ----
message.sprite = Sprite();
fun message_callback (text)
{
    global.message.image = Image.Text(text, 0.65, 0.64, 0.61, 1, "Sans 9");
    message.sprite.SetImage(global.message.image);
    message.sprite.SetPosition(centre.x - global.message.image.GetWidth() / 2, screen.y + screen.h - 48, 3);
}
Plymouth.SetMessageFunction(message_callback);
