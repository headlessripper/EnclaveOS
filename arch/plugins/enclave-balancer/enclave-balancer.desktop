[Xfce Panel]
Type=X-XFCE-PanelPlugin
Encoding=UTF-8
Name=Centering Balancer
Comment=Invisible spacer that matches the tray's width, so centred taskbar items sit at the true centre of the screen
Icon=format-justify-center
X-XFCE-Module=enclave-balancer
X-XFCE-Internal=true
X-XFCE-Unique=false
X-XFCE-API=2.0
