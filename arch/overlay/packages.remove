# Enclave debloat — releng live-ISO packages to strip from the final image.
# build-iso.sh removes any of these from the assembled packages.x86_64.
# (Lines that aren't present in releng are harmless no-ops.)
# Nothing here is needed to boot the Enclave desktop or install it.

# --- IRC / web / shell clients not needed on a consumer desktop ---
irssi
lynx
lftp
tmux
nmap

# --- legacy dial-up / WAN / modem stacks ---
ppp
rp-pppoe
wvdial
xl2tpd
vpnc
linux-atm
usb_modeswitch

# --- firmware blobs for ancient/obscure wifi (not general linux-firmware) ---
b43-fwcutter
broadcom-wl-dkms
ipw2100-fw
ipw2200-fw

# --- disk-imaging / recovery tools (Enclave installs via its own flow) ---
partclone
partimage
fsarchiver
ddrescue
clonezilla

# --- misc live-medium extras ---
gpm
darkhttpd
refind
livecd-sounds

# Boot: the image boots UEFI only, straight into Enclave's own themed GRUB
# menu with a single entry, so the BIOS loader, RAM tester and UEFI shell go.
syslinux
memtest86+
memtest86+-efi
edk2-shell

# --- 2026-11-25: a small ISO. Rescue / admin / server tools a desktop live
#     session never uses (the installed system can add any of them). ---
archinstall
cloud-init
brltty
espeakup
memtest86+
memtest86+-efi
edk2-shell
syslinux
testdisk
tcpdump
openconnect
openvpn
pptpclient
modemmanager
mmc-utils
mc
screen
vim
man-db
man-pages
sequoia-sq
openpgp-card-tools
bind
ldns
ndisc6
dnsmasq
nilfs-utils
jfsutils
bcachefs-tools
f2fs-tools
dmraid
mdadm
gpart
sdparm
sg3_utils
smartmontools
udftools
usbmuxd
lsscsi
iwd
linux-firmware-marvell
