# Enclave OS — packages appended to releng/packages.x86_64 by build-iso.sh.
# Desktop: Enclave Shell, Enclave's own Wayland desktop (Qt 6 / QML), with
# Hyprland managing windows underneath (rounded corners, blur) — see the "Enclave Shell" section below
# and docs/superpowers/specs/2026-11-24-enclave-shell-design.md. XFCE and the
# old X11 pieces (panel, picom, GTK Start menu, X11 bubble) were removed.

# --- Graphical boot splash (hides the boot logs behind an Enclave skin) ---
plymouth

# --- Display manager. SDDM's greeter itself runs on X11 (its Wayland greeter
#     black-screens on VMware's virtual GPU); the session it starts is Wayland.
sddm
xorg-server
xorg-xauth
xf86-input-libinput

# --- Desktop services ---
# nm-connection-editor: VPNs and advanced connections, linked from
# Settings > Network (everyday Wi-Fi is Settings itself)
network-manager-applet
xdg-desktop-portal
xdg-desktop-portal-gtk

# --- Theme fallbacks + UI font ---
# The Enclave GTK/window theme, icons and cursor are built from pinned Fluent
# sources by build-iso.sh. Adwaita (gnome-themes-extra) is the GTK fallback.
gnome-themes-extra
# Inter: the clean UI typeface (Segoe UI / SF Pro proportions).
inter-font

# --- Core apps for a usable first session (the Windows-equivalent set) ---
# Files is Enclave's own (enclave-files, part of Enclave Shell). gvfs gives
# it and other apps mounting; tumbler makes thumbnails for GTK apps.
gvfs
tumbler
xarchiver
mousepad
# Photos + media player
ristretto
celluloid
# Mail (Zen Browser, the default browser, is built from the AUR by build-iso.sh)
thunderbird
zen-browser-bin
xdg-utils

# --- Networking ---
networkmanager

# --- Audio (PipeWire stack) ---
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
pavucontrol

# --- Graphics / Mesa ---
mesa
vulkan-icd-loader

# --- Fonts ---
noto-fonts
noto-fonts-emoji
ttf-dejavu

# --- VM guest integration (dev/test target is VMware; cover common VMs) ---
open-vm-tools
spice-vdagent
qemu-guest-agent

# --- Phase 2: universal apps (official + multilib only) ---
# Linux apps:
flatpak
xdg-user-dirs
# Windows apps (Wine); Proton/Steam/Waydroid are AUR/heavy -> enclave-appsetup:
wine
winetricks
cabextract
ttf-liberation
# 32-bit runtime bits Wine/Proton need:
lib32-mesa
lib32-vulkan-icd-loader
lib32-gnutls
lib32-pipewire
vulkan-tools

# --- Phase 4: graphical installer (Calamares) ---
# calamares itself is built from the AUR into a local repo at build time
# (no trustworthy prebuilt exists for Arch); see scripts/build-iso.sh.
# These are what Calamares shells out to while installing to disk:
calamares
grub
efibootmgr
# finds Windows / other systems so the boot menu shows only when there is a choice
os-prober
squashfs-tools
parted
dosfstools
e2fsprogs
mkinitcpio

# --- Phase 3: advisory assistant + voice runtime (official bits only) ---
# The assistant app (Alpha Code chat layer), the local model runner (llama.cpp),
# and OpenVox are installed opt-in by enclave-assistant-setup (AUR/pip/heavy).
python
python-pip
python-pipx
python-virtualenv
python-keyring

# --- Enclave Shell (Enclave's own Wayland desktop; the "Enclave"
#     session — see docs/superpowers/specs/2026-11-24-enclave-shell-design.md) ---
hyprland
xdg-desktop-portal-hyprland
xorg-xwayland
layer-shell-qt
qt6-base
qt6-declarative
qt6-wayland
qt6-svg
xdg-desktop-portal-wlr
adwaita-icon-theme
papirus-icon-theme
grim
slurp
wtype
brightnessctl
# Enclave Terminal: QTermWidget (the Konsole engine) and its monospace face
qtermwidget
ttf-jetbrains-mono
wl-clipboard
libnotify
mako
polkit-gnome
# wlr-randr: display modes for wlroots tools (Settings uses hyprctl)
wlr-randr
# Settings > Power: power modes (balanced / saver / performance)
power-profiles-daemon
# Settings > About: the graphics card's name
pciutils
