# Enclave OS — packages appended to releng/packages.x86_64 by build-iso.sh.
# Phase 0: boot to a basic branded Plasma 6 (Wayland) session, kept lean
# (curated Plasma, not plasma-meta). Theming/polish is Phase 1.

# --- Display manager + Plasma 6 shell ---
sddm
plasma-desktop
plasma-workspace
kwin
# X11 session + server. Default live session is X11 (plasmax11.desktop) because
# Wayland on VMware/VBox virtual GPUs black-screens; Xorg's modesetting driver
# drives the virtual GPU reliably. plasma-workspace ships startplasma-x11; these
# give it a server to run on. (Wayland stays available in the greeter menu.)
xorg-server
xorg-xauth
xorg-xinit
# Xorg input driver (keyboard/mouse under X) + the VMware SVGA video/mouse
# drivers so Xorg reliably finds a screen and input in VMware.
xf86-input-libinput
xf86-video-vmware
xf86-input-vmmouse
systemsettings
kscreen
powerdevil
plasma-pa
plasma-nm
breeze
breeze-gtk
xdg-desktop-portal
xdg-desktop-portal-kde

# --- Core apps for a usable first session ---
dolphin
konsole
ark

# --- Networking ---
networkmanager

# --- Audio (PipeWire stack) ---
pipewire
pipewire-alsa
pipewire-pulse
wireplumber

# --- Graphics / Mesa ---
mesa
vulkan-icd-loader

# --- Fonts ---
noto-fonts
noto-fonts-emoji
ttf-dejavu

# --- VM guest integration (dev/test target is VMware; cover common VMs) ---
open-vm-tools
spice-vdagent
qemu-guest-agent

# --- Phase 2: universal apps (official + multilib only) ---
# Linux apps:
flatpak
xdg-user-dirs
# Windows apps (Wine); Proton/Steam/Waydroid are AUR/heavy -> enclave-appsetup:
wine
winetricks
cabextract
ttf-liberation
# 32-bit runtime bits Wine/Proton need:
lib32-mesa
lib32-vulkan-icd-loader
lib32-gnutls
lib32-pipewire
vulkan-tools

# --- Phase 4: graphical installer (Calamares) ---
# calamares itself is built from the AUR into a local repo at build time
# (no trustworthy prebuilt exists for Arch); see scripts/build-iso.sh.
# These are what Calamares shells out to while installing to disk:
calamares
grub
efibootmgr
squashfs-tools
parted
dosfstools
e2fsprogs
mkinitcpio

# --- Phase 3: advisory assistant + voice runtime (official bits only) ---
# The assistant app (Alpha Code chat layer), the local model runner (llama.cpp),
# and OpenVox are installed opt-in by enclave-assistant-setup (AUR/pip/heavy).
python
python-pip
python-pipx
python-virtualenv
python-keyring
