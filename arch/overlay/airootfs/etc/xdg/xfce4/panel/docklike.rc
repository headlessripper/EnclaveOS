# Enclave OS — taskbar apps (Docklike plugin) defaults.
# Docklike loads $XDG_CONFIG_DIRS/xfce4/panel/docklike.rc when the user has no
# docklike-<id>.rc yet. `pinned` = desktop-file IDs (no .desktop suffix).
[user]
pinned=thunar;zen;org.mozilla.Thunderbird;enclave-assistant;xfce4-terminal;
showPreviews=false
showWindowCount=false
noWindowsListIfSingle=true
onlyDisplayVisible=false
onlyDisplayScreen=false
forceIconSize=true
iconSize=26
indicatorColorFromTheme=true
keyComboActive=true
keyAloneActive=false
middleButtonBehavior=0
