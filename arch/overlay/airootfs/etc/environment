# Enclave OS — session-wide environment.
#
# Plasma 6.8 is Wayland-only, and KWin's Wayland compositor needs an OpenGL
# context. VMware/VirtualBox virtual GPUs don't provide a usable hardware GL,
# which shows up as a black screen after login. Forcing Mesa's software
# renderer (llvmpipe) gives KWin the GL it needs, so the desktop renders in a
# VM regardless of whether "3D acceleration" is enabled.
#
# On real hardware this trades GPU acceleration for software rendering; it's the
# safe default while Enclave's primary target is virtual machines.
LIBGL_ALWAYS_SOFTWARE=1
GALLIUM_DRIVER=llvmpipe
