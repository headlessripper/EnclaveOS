<?xml version="1.0" encoding="UTF-8"?>
<!-- Enclave Files — extra right-click actions. (Extract Here / Compress come
     from thunar-archive-plugin; "Open in New Window" is built in.) -->
<actions>
  <action>
    <icon>utilities-terminal</icon>
    <name>Open Terminal Here</name>
    <unique-id>enclave-terminal</unique-id>
    <command>xfce4-terminal --working-directory %f</command>
    <description>Open a terminal in this folder</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
  <action>
    <icon>security-high</icon>
    <name>Open as Administrator</name>
    <unique-id>enclave-admin</unique-id>
    <!-- pkexec drops DISPLAY/XAUTHORITY, so pass them through explicitly or
         the elevated window can't open. -->
    <command>sh -c 'pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" thunar "$1"' sh %f</command>
    <description>Open this folder with administrator rights</description>
    <patterns>*</patterns>
    <directories/>
  </action>
</actions>
