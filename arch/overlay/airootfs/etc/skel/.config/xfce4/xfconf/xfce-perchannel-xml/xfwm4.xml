<?xml version="1.0" encoding="UTF-8"?>
<!-- Enclave OS — window manager.
     Windows-style title bars: app icon at the top-left (the "O" button, enabled
     in the Enclave frame theme by build-iso.sh), title left-aligned, and
     minimize / maximize / close on the right. New windows open centred (macOS),
     dragging a window to a screen edge snaps it to half the screen (Windows
     Snap). Compositing (shadows, rounded corners, blur) is picom's job; the
     enclave-compositor launcher re-enables xfwm4's own compositor if picom
     can't run. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Enclave"/>
    <property name="title_font" type="string" value="Inter Semi-Bold 10"/>
    <property name="title_alignment" type="string" value="left"/>
    <property name="button_layout" type="string" value="O|HMC"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="frame_opacity" type="int" value="100"/>
    <property name="placement_mode" type="string" value="center"/>
    <property name="placement_ratio" type="int" value="100"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="false"/>
    <property name="tile_on_move" type="bool" value="true"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
    <property name="wrap_windows" type="bool" value="false"/>
    <property name="workspace_count" type="int" value="1"/>
    <property name="double_click_action" type="string" value="maximize"/>
    <property name="cycle_preview" type="bool" value="true"/>
    <property name="cycle_minimum" type="bool" value="false"/>
    <property name="cycle_draw_frame" type="bool" value="false"/>
  </property>
</channel>
