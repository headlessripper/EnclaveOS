[Desktop Entry]
# Enclave OS — the single Settings app. No "Settings" category, so the Start
# menu's de-clutter rules (which hide every individual settings panel) never
# hide Settings itself.
Type=Application
Name=Settings
GenericName=Settings
Comment=Change how Enclave looks and works
Exec=xfce4-settings-manager
Icon=preferences-system
Terminal=false
StartupNotify=true
Categories=System;
Keywords=settings;control panel;preferences;system;
