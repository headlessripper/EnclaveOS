[Desktop Entry]
# Enclave OS — Thunar presented as "Files" (overrides /usr/share/applications
# because /usr/local/share comes first in XDG_DATA_DIRS).
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse your files
Exec=thunar %F
Icon=system-file-manager
Terminal=false
StartupNotify=true
Categories=System;Utility;Core;GTK;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;explorer;file manager;folders;browse;
Actions=open-home;open-computer;

[Desktop Action open-home]
Name=Home
Exec=thunar

[Desktop Action open-computer]
Name=This PC
Exec=thunar computer:///
