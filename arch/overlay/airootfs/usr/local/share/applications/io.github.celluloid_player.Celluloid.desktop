[Desktop Entry]
# Enclave OS — Celluloid presented as "Media Player".
Type=Application
Name=Media Player
GenericName=Media Player
Comment=Play videos and music
Exec=celluloid %U
Icon=io.github.celluloid_player.Celluloid
Terminal=false
StartupNotify=true
Categories=AudioVideo;Audio;Video;Player;GTK;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/ogg;audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/aac;
Keywords=video;movie;music;audio;player;
