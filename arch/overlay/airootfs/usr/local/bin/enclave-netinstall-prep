#!/bin/sh
# Enclave OS installer — before the apps are downloaded (Calamares runs this
# outside the target; the packages module then installs
# /usr/share/enclave/netinstall/packages into it from the Arch mirrors).
# Gives the new system what pacman needs to download: DNS, mirrors, the
# [multilib] repository (Wine's 32-bit parts) and a populated keyring.
#   enclave-netinstall-prep <target-root>
set -eu
R="${1:?usage: enclave-netinstall-prep <target-root>}"

# DNS: borrow the live system's resolver for the install (put back after).
if [ -e "$R/etc/resolv.conf" ] || [ -L "$R/etc/resolv.conf" ]; then
  mv -f "$R/etc/resolv.conf" "$R/etc/resolv.conf.enclave-saved"
fi
cp -L /etc/resolv.conf "$R/etc/resolv.conf"

# Mirrors: the live system's ranked list (reflector), else Arch's worldwide CDN.
mkdir -p "$R/etc/pacman.d"
if grep -q '^Server' /etc/pacman.d/mirrorlist 2>/dev/null; then
  cp -f /etc/pacman.d/mirrorlist "$R/etc/pacman.d/mirrorlist"
fi
if ! grep -q '^Server' "$R/etc/pacman.d/mirrorlist" 2>/dev/null; then
  printf '%s\n' '# Enclave OS — Arch Linux worldwide mirrors' \
    'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' \
    'Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch' \
    'Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch' > "$R/etc/pacman.d/mirrorlist"
fi

# [multilib]: Windows apps need 32-bit libraries.
if ! grep -q '^\[multilib\]' "$R/etc/pacman.conf"; then
  sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' "$R/etc/pacman.conf"
  grep -q '^\[multilib\]' "$R/etc/pacman.conf" \
    || printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> "$R/etc/pacman.conf"
fi

# Keyring: packages are verified against Arch's signing keys.
chroot "$R" pacman-key --init
chroot "$R" pacman-key --populate archlinux
echo "enclave-netinstall-prep: ready to download apps into $R"
