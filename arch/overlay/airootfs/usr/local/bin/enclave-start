# ---------------------------------------------------------------------------
# data
# ---------------------------------------------------------------------------
def load_menu_rules(path=MENU_FILE):
    """(excluded categories, excluded desktop ids, re-included ids) from the
    Enclave menu file — the same rules the rest of the desktop uses."""
    cats, files, reinclude = set(SETTINGS_CATS), set(), {"xfce-settings-manager.desktop"}
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return cats, files, reinclude
    cats, files, reinclude = set(), set(), set()
    seen_exclude = False
    for el in root:
        if el.tag == "Exclude":
            seen_exclude = True
            for n in el.iter():
                if n.tag == "Category" and n.text:
                    cats.add(n.text.strip())
                elif n.tag == "Filename" and n.text:
                    files.add(n.text.strip())
        elif el.tag == "Include" and seen_exclude:
            for n in el.iter("Filename"):
                if n.text:
                    reinclude.add(n.text.strip())
    return cats, files, reinclude


class App:
    __slots__ = ("id", "info", "name", "haystack", "is_setting", "path")

    def __init__(self, info, is_setting):
        self.id = info.get_id()
        self.info = info
        self.name = info.get_display_name() or info.get_name() or self.id
        bits = [self.name, info.get_generic_name() or "", info.get_executable() or ""]
        bits += list(info.get_keywords() or [])
        self.haystack = " ".join(bits).lower()
        self.is_setting = is_setting
        self.path = info.get_filename() or ""

    def icon(self):
        return self.info.get_icon() or Gio.ThemedIcon.new("application-x-executable")

    def score(self, q):
        n = self.name.lower()
        if n == q:
            return 120
        if n.startswith(q):
            return 100
        if any(w.startswith(q) for w in n.split()):
            return 80
        if q in n:
            return 60
        if q in self.haystack:
            return 30
        return 0


def load_apps():
    cats, excluded, reinclude = load_menu_rules()
    listed, settings = {}, {}
    for info in Gio.AppInfo.get_all():
        # Desktop-file apps only (they have categories); skip hidden ones.
        if not callable(getattr(info, "get_categories", None)) or not info.should_show():
            continue
        aid = info.get_id()
        if aid in SEARCH_HIDDEN:
            continue
        app_cats = {c for c in (info.get_categories() or "").split(";") if c}
        if aid in reinclude or (aid not in excluded and not (app_cats & cats)):
            listed[aid] = App(info, False)
        elif app_cats & SETTINGS_CATS:
            settings[aid] = App(info, True)
    return listed, settings


def load_pins():
    for path in (CONF_FILE, DEFAULTS_FILE):
        try:
            with open(path, encoding="utf-8") as f:
                pins = json.load(f).get("pinned")
            if isinstance(pins, list):
                return [p for p in pins if isinstance(p, str)]
        except (OSError, ValueError):
            continue
    return list(FALLBACK_PINS)


def save_pins(pins):
    try:
        os.makedirs(os.path.dirname(CONF_FILE), exist_ok=True)
        tmp = CONF_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"pinned": pins}, f, indent=2)
        os.replace(tmp, CONF_FILE)
    except OSError:
        pass


def friendly_time(ts):
    if not ts:
        return ""
    now = time.time()
    t = time.localtime(ts)
    today = time.localtime(now)
    if t.tm_year == today.tm_year and t.tm_yday == today.tm_yday:
        return time.strftime("Today %H:%M", t)
    if now - ts < 2 * 86400 and t.tm_yday == (today.tm_yday - 1) % 366:
        return time.strftime("Yesterday %H:%M", t)
    if now - ts < 7 * 86400:
        return time.strftime("%A", t)
    return time.strftime("%d %b", t)


def recent_files(limit):
    items = []
    try:
        for it in Gtk.RecentManager.get_default().get_items():
            if not it.is_local() or not it.exists():
                continue
            items.append(it)
    except Exception:
        return []
    items.sort(key=lambda it: it.get_modified(), reverse=True)
    return items[:limit]


def recently_added_apps(apps, days=14):
    """Apps the user installed lately (their launchers live in user / flatpak
    dirs, not the system image)."""
    cutoff = time.time() - days * 86400
    user_dirs = (
        os.path.join(GLib.get_user_data_dir(), "applications"),
        os.path.join(GLib.get_user_data_dir(), "flatpak", "exports"),
        "/var/lib/flatpak/exports",
    )
    out = []
    for app in apps.values():
        if not app.path.startswith(user_dirs):
            continue
        try:
            mtime = os.stat(app.path).st_mtime
        except OSError:
            continue
        if mtime >= cutoff:
            out.append((mtime, app))
    out.sort(key=lambda x: x[0], reverse=True)
    return out


# ---------------------------------------------------------------------------
# widgets
# ---------------------------------------------------------------------------
def icon_image(gicon, size):
    img = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.DIALOG)
    img.set_pixel_size(size)
    return img


def label(text, *classes, xalign=0.0, ellipsize=True, max_chars=-1):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if ellipsize:
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
    if max_chars > 0:
        lbl.set_max_width_chars(max_chars)
    for c in classes:
        lbl.get_style_context().add_class(c)
    return lbl


class Avatar(Gtk.DrawingArea):
    """Round account picture (~/.face), or the user's initial on an orange disc."""

    def __init__(self, name, size=32):
        super().__init__()
        self.size = size
        self.set_size_request(size, size)
        self.initial = (name[:1] or "?").upper()
        self.pixbuf = None
        face = os.path.expanduser("~/.face")
        if os.path.isfile(face):
            try:
                self.pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(face, size, size, False)
            except GLib.Error:
                self.pixbuf = None
        self.connect("draw", self._draw)

    def _draw(self, _w, cr):
        s = self.size
        cr.arc(s / 2, s / 2, s / 2, 0, 2 * 3.14159265)
        cr.clip()
        if self.pixbuf is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
            cr.paint()
            return False
        cr.set_source_rgb(1.0, 0.42, 0.10)
        cr.paint()
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription.from_string(f"Inter Semi-Bold {int(s * 0.42)}px"))
        layout.set_text(self.initial, -1)
        w, h = layout.get_pixel_size()
        cr.set_source_rgb(1, 1, 1)
        cr.move_to((s - w) / 2, (s - h) / 2)
        PangoCairo.show_layout(cr, layout)
        return False


# ---------------------------------------------------------------------------
# the menu window
# ---------------------------------------------------------------------------
class StartMenu(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.app = app
        self.set_title("Start")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_default_size(WIDTH, HEIGHT)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.connect("draw", self._clear_background)
        screen.connect("composited-changed", lambda *_: self._update_solid())

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.apps, self.settings = {}, {}
        self.pins = load_pins()
        self.rec_expanded = False
        self._hidden_at = 0.0
        self._search_gen = 0

        self._build()
        self._update_solid()
        self.reload_apps()
        Gio.AppInfoMonitor.get().connect("changed", lambda *_: self.reload_apps())

        self.connect("focus-out-event", self._on_focus_out)
        self.connect("key-press-event", self._on_key)
        self.connect("delete-event", lambda *_: self.hide_menu() or True)

    # --- layout ------------------------------------------------------------
    def _build(self):
        self.frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.frame.get_style_context().add_class("start")

        self.revealer = Gtk.Revealer()
        self.revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.revealer.set_transition_duration(170)
        self.revealer.add(self.frame)
        self.add(self.revealer)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        body.set_margin_top(26)
        body.set_margin_start(30)
        body.set_margin_end(30)
        body.set_margin_bottom(12)
        self.frame.pack_start(body, True, True, 0)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search for apps, settings and documents")
        self.search.get_style_context().add_class("search")
        self.search.connect("search-changed", self._on_search_changed)
        self.search.connect("activate", self._on_search_activate)
        self.search.connect("key-press-event", self._on_search_key)
        body.pack_start(self.search, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        body.pack_start(self.stack, True, True, 0)

        self.stack.add_named(self._build_home(), "home")
        self.stack.add_named(self._build_all(), "all")
        self.stack.add_named(self._build_search(), "search")

        self.frame.pack_end(self._build_footer(), False, False, 0)

    def _header(self, title, button_text, callback):
        row = Gtk.Box(spacing=8)
        row.pack_start(label(title, "section-title"), False, False, 0)
        if button_text:
            b = Gtk.Button(label=button_text)
            b.get_style_context().add_class("pill")
            b.set_can_focus(False)
            b.connect("clicked", callback)
            row.pack_end(b, False, False, 0)
            return row, b
        return row, None

    def _build_home(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        hdr, _ = self._header("Pinned", "All apps  ›", lambda *_: self.show_page("all"))
        box.pack_start(hdr, False, False, 4)

        self.pin_grid = Gtk.FlowBox()
        self.pin_grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.pin_grid.set_homogeneous(True)
        self.pin_grid.set_min_children_per_line(PIN_COLS)
        self.pin_grid.set_max_children_per_line(PIN_COLS)
        self.pin_grid.set_row_spacing(4)
        self.pin_grid.set_column_spacing(4)
        self.pin_grid.set_valign(Gtk.Align.START)
        pin_scroll = Gtk.ScrolledWindow()
        pin_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        pin_scroll.set_min_content_height(290)
        pin_scroll.set_max_content_height(290)
        pin_scroll.set_propagate_natural_height(True)
        pin_scroll.add(self.pin_grid)
        box.pack_start(pin_scroll, False, False, 0)

        hdr, self.more_btn = self._header("Recommended", "More  ›", self._toggle_more)
        hdr.set_margin_top(10)
        box.pack_start(hdr, False, False, 4)

        self.rec_grid = Gtk.FlowBox()
        self.rec_grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.rec_grid.set_homogeneous(True)
        self.rec_grid.set_min_children_per_line(2)
        self.rec_grid.set_max_children_per_line(2)
        self.rec_grid.set_column_spacing(8)
        self.rec_grid.set_row_spacing(2)
        self.rec_grid.set_valign(Gtk.Align.START)
        rec_scroll = Gtk.ScrolledWindow()
        rec_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        rec_scroll.add(self.rec_grid)
        box.pack_start(rec_scroll, True, True, 0)
        return box

    def _build_all(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        hdr, _ = self._header("All apps", "‹  Back", lambda *_: self.show_page("home"))
        box.pack_start(hdr, False, False, 4)
        self.all_list = Gtk.ListBox()
        self.all_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.all_list.set_activate_on_single_click(True)
        self.all_list.set_header_func(self._letter_header, None)
        self.all_list.connect("row-activated", self._on_row_activated)
        self.all_list.connect("button-press-event", self._on_list_press)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.all_list)
        box.pack_start(scroll, True, True, 0)
        return box

    def _build_search(self):
        self.search_list = Gtk.ListBox()
        self.search_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.search_list.set_activate_on_single_click(True)
        self.search_list.set_header_func(self._group_header, None)
        self.search_list.connect("row-activated", self._on_row_activated)
        self.search_list.connect("button-press-event", self._on_list_press)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.search_list)
        self.search_empty = label("No results", "empty", xalign=0.5)
        overlay = Gtk.Overlay()
        overlay.add(scroll)
        overlay.add_overlay(self.search_empty)
        self.search_empty.set_valign(Gtk.Align.START)
        self.search_empty.set_margin_top(40)
        self.search_empty.set_no_show_all(True)
        return overlay

    def _build_footer(self):
        foot = Gtk.Box(spacing=10)
        foot.get_style_context().add_class("footer")
        try:
            pw = pwd.getpwuid(os.getuid())
            name = (pw.pw_gecos.split(",")[0] or pw.pw_name).strip() or pw.pw_name
        except KeyError:
            name = GLib.get_user_name()
        if name.islower():
            name = name.capitalize()
        foot.pack_start(Avatar(name, 32), False, False, 0)
        foot.pack_start(label(name), False, False, 2)

        power = self._round_button("system-shutdown-symbolic", "Power")
        power.connect("clicked", self._show_power)
        foot.pack_end(power, False, False, 0)
        gear = self._round_button("emblem-system-symbolic", "Settings")
        gear.connect("clicked", lambda *_: self.launch_id("xfce-settings-manager.desktop"))
        foot.pack_end(gear, False, False, 0)

        self.power_pop = Gtk.Popover.new(power)
        self.power_pop.set_position(Gtk.PositionType.TOP)
        pbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for icon, text, argv in (
            ("system-lock-screen-symbolic", "Lock", ["xflock4"]),
            ("weather-clear-night-symbolic", "Sleep", ["xfce4-session-logout", "--suspend"]),
            ("system-log-out-symbolic", "Sign out", ["xfce4-session-logout", "--logout"]),
            ("system-reboot-symbolic", "Restart", ["xfce4-session-logout", "--reboot"]),
            ("system-shutdown-symbolic", "Shut down", ["xfce4-session-logout", "--halt"]),
        ):
            b = Gtk.Button()
            row = Gtk.Box(spacing=10)
            row.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU), False, False, 0)
            row.pack_start(label(text), False, False, 0)
            b.add(row)
            b.connect("clicked", self._run_power, argv)
            pbox.pack_start(b, False, False, 0)
        pbox.show_all()
        self.power_pop.add(pbox)
        return foot

    def _round_button(self, icon, tip):
        b = Gtk.Button()
        b.add(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR))
        b.set_tooltip_text(tip)
        b.get_style_context().add_class("round")
        return b

    # --- content -----------------------------------------------------------
    def reload_apps(self):
        self.apps, self.settings = load_apps()
        self._fill_pins()
        self._fill_all()

    def _all_known(self, aid):
        return self.apps.get(aid) or self.settings.get(aid)

    def _tile(self, app):
        b = Gtk.Button()
        b.get_style_context().add_class("tile")
        b.set_tooltip_text(app.name)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        v.pack_start(icon_image(app.icon(), ICON_TILE), False, False, 0)
        lbl = label(app.name, "tile-label", xalign=0.5, max_chars=11)
        lbl.set_justify(Gtk.Justification.CENTER)
        v.pack_start(lbl, False, False, 0)
        b.add(v)
        b.connect("clicked", lambda *_: self.launch(app))
        b.connect("button-press-event", self._on_tile_press, app)
        return b

    def _fill_pins(self):
        for c in self.pin_grid.get_children():
            self.pin_grid.remove(c)
        for aid in self.pins:
            app = self._all_known(aid)
            if app is not None:
                self.pin_grid.add(self._tile(app))
        self.pin_grid.show_all()

    def _rec_item(self, gicon, title, subtitle, on_click):
        b = Gtk.Button()
        b.get_style_context().add_class("rec")
        h = Gtk.Box(spacing=12)
        h.pack_start(icon_image(gicon, 30), False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        v.set_valign(Gtk.Align.CENTER)
        v.pack_start(label(title), False, False, 0)
        if subtitle:
            v.pack_start(label(subtitle, "subtitle"), False, False, 0)
        h.pack_start(v, True, True, 0)
        b.add(h)
        b.connect("clicked", lambda *_: on_click())
        return b

    def _fill_recommended(self):
        for c in self.rec_grid.get_children():
            self.rec_grid.remove(c)
        limit = REC_MORE if self.rec_expanded else REC_SHOW
        entries = []
        for mtime, app in recently_added_apps(self.apps):
            entries.append((mtime, self._rec_item(app.icon(), app.name, "Recently added",
                                                   lambda a=app: self.launch(a))))
        for it in recent_files(limit):
            uri = it.get_uri()
            gicon = it.get_gicon() or Gio.ThemedIcon.new("text-x-generic")
            entries.append((it.get_modified(), self._rec_item(
                gicon, it.get_display_name(), friendly_time(it.get_modified()),
                lambda u=uri: self.open_uri(u))))
        entries.sort(key=lambda e: e[0], reverse=True)
        widgets = [w for _, w in entries[:limit]]
        if not widgets:
            # Fresh system: a "Get started" set instead of an empty box.
            for aid, text in GET_STARTED:
                app = self._all_known(aid)
                if app is not None:
                    widgets.append(self._rec_item(app.icon(), text, app.name,
                                                  lambda a=app: self.launch(a)))
            self.more_btn.hide()
        else:
            self.more_btn.set_visible(len(entries) > REC_SHOW)
            self.more_btn.set_label("Less  ‹" if self.rec_expanded else "More  ›")
        for w in widgets[:limit]:
            self.rec_grid.add(w)
        self.rec_grid.show_all()

    def _toggle_more(self, *_):
        self.rec_expanded = not self.rec_expanded
        self._fill_recommended()

    def _app_row(self, app, subtitle=None, kind="app"):
        row = Gtk.ListBoxRow()
        row.app, row.uri, row.kind = app, None, kind
        row.sort_name = app.name.lower()
        h = Gtk.Box(spacing=12)
        h.pack_start(icon_image(app.icon(), ICON_ROW), False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        v.set_valign(Gtk.Align.CENTER)
        v.pack_start(label(app.name), False, False, 0)
        if subtitle:
            v.pack_start(label(subtitle, "subtitle"), False, False, 0)
        h.pack_start(v, True, True, 0)
        row.add(h)
        return row

    def _file_row(self, path):
        row = Gtk.ListBoxRow()
        row.app, row.uri, row.kind = None, GLib.filename_to_uri(path, None), "file"
        h = Gtk.Box(spacing=12)
        gicon = Gio.content_type_get_icon(Gio.content_type_guess(path, None)[0])
        h.pack_start(icon_image(gicon, ICON_ROW), False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        v.set_valign(Gtk.Align.CENTER)
        v.pack_start(label(os.path.basename(path)), False, False, 0)
        home = os.path.expanduser("~")
        where = os.path.dirname(path)
        where = "~" + where[len(home):] if where.startswith(home) else where
        v.pack_start(label(where, "subtitle"), False, False, 0)
        h.pack_start(v, True, True, 0)
        row.add(h)
        return row

    def _fill_all(self):
        for c in self.all_list.get_children():
            self.all_list.remove(c)
        for app in sorted(self.apps.values(), key=lambda a: a.name.lower()):
            self.all_list.add(self._app_row(app))
        self.all_list.show_all()

    @staticmethod
    def _letter_of(row):
        ch = row.sort_name[:1].upper()
        return ch if ch.isalpha() else "#"

    def _letter_header(self, row, before, _data):
        letter = self._letter_of(row)
        if before is None or self._letter_of(before) != letter:
            row.set_header(label(letter, "letter"))
        else:
            row.set_header(None)

    def _group_header(self, row, before, _data):
        names = {"app": "Apps", "setting": "Settings", "file": "Documents"}
        if before is None or before.kind != row.kind:
            row.set_header(label(names[row.kind], "group"))
        else:
            row.set_header(None)

    # --- search ------------------------------------------------------------
    def _on_search_changed(self, entry):
        q = entry.get_text().strip().lower()
        self._search_gen += 1
        if not q:
            self.show_page("home")
            return
        self.show_page("search", keep_search=True)
        for c in self.search_list.get_children():
            self.search_list.remove(c)

        def ranked(pool, limit):
            scored = [(a.score(q), a) for a in pool.values()]
            scored = [x for x in scored if x[0] > 0]
            scored.sort(key=lambda x: (-x[0], x[1].name.lower()))
            return [a for _, a in scored[:limit]]

        for app in ranked(self.apps, 8):
            self.search_list.add(self._app_row(app, None, "app"))
        for app in ranked(self.settings, 5):
            self.search_list.add(self._app_row(app, "Settings", "setting"))
        self.search_list.show_all()
        self._select_first(self.search_list)
        self._update_search_empty()

        gen = self._search_gen
        threading.Thread(target=self._find_files, args=(q, gen), daemon=True).start()

    def _find_files(self, q, gen, limit=12, budget=6000):
        found, seen = [], 0
        for it in recent_files(200):
            p = GLib.filename_from_uri(it.get_uri())[0]
            if q in os.path.basename(p).lower() and p not in found:
                found.append(p)
        home = os.path.expanduser("~")
        stack = [os.path.join(home, d) for d in FILE_ROOTS] + [home]
        depth = {p: 0 for p in stack}
        while stack and len(found) < limit and seen < budget:
            if gen != self._search_gen:
                return
            d = stack.pop(0)
            try:
                with os.scandir(d) as it:
                    for e in it:
                        seen += 1
                        if e.name.startswith("."):
                            continue
                        if e.is_dir(follow_symlinks=False):
                            if d != home and depth[d] < 4:
                                depth[e.path] = depth[d] + 1
                                stack.append(e.path)
                        elif q in e.name.lower() and e.path not in found:
                            found.append(e.path)
                            if len(found) >= limit:
                                break
            except OSError:
                continue
        GLib.idle_add(self._add_files, gen, found[:limit])

    def _add_files(self, gen, paths):
        if gen != self._search_gen:
            return False
        for p in paths:
            self.search_list.add(self._file_row(p))
        self.search_list.show_all()
        if self.search_list.get_selected_row() is None:
            self._select_first(self.search_list)
        self._update_search_empty()
        return False

    def _update_search_empty(self):
        self.search_empty.set_visible(not self.search_list.get_children())

    @staticmethod
    def _select_first(lst):
        row = lst.get_row_at_index(0)
        if row is not None:
            lst.select_row(row)

    def _on_search_activate(self, _entry):
        lst = self._current_list()
        if lst is None:
            return
        row = lst.get_selected_row() or lst.get_row_at_index(0)
        if row is not None:
            self._on_row_activated(lst, row)

    def _on_search_key(self, _entry, event):
        if event.keyval in (Gdk.KEY_Down, Gdk.KEY_Up):
            lst = self._current_list()
            if lst is None:
                return False
            row = lst.get_selected_row()
            i = row.get_index() if row is not None else -1
            i = i + 1 if event.keyval == Gdk.KEY_Down else max(0, i - 1)
            nxt = lst.get_row_at_index(i)
            if nxt is not None:
                lst.select_row(nxt)
                adj = lst.get_adjustment()
                alloc = nxt.get_allocation()
                if adj is not None:
                    adj.clamp_page(alloc.y, alloc.y + alloc.height)
            return True
        return False

    def _current_list(self):
        page = self.stack.get_visible_child_name()
        return {"search": self.search_list, "all": self.all_list}.get(page)

    # --- actions -----------------------------------------------------------
    def _launch_ctx(self):
        ctx = Gdk.Display.get_default().get_app_launch_context()
        ctx.set_timestamp(Gtk.get_current_event_time())
        return ctx

    def launch(self, app):
        self.hide_menu()
        try:
            app.info.launch([], self._launch_ctx())
        except GLib.Error as e:
            print(f"enclave-start: could not launch {app.id}: {e.message}", file=sys.stderr)

    def launch_id(self, aid):
        app = self._all_known(aid)
        if app is not None:
            self.launch(app)

    def open_uri(self, uri):
        self.hide_menu()
        try:
            Gio.AppInfo.launch_default_for_uri(uri, self._launch_ctx())
        except GLib.Error as e:
            print(f"enclave-start: could not open {uri}: {e.message}", file=sys.stderr)

    def _on_row_activated(self, _lst, row):
        if row.app is not None:
            self.launch(row.app)
        elif row.uri:
            self.open_uri(row.uri)

    def _run_power(self, _b, argv):
        self.power_pop.popdown()
        self.hide_menu()
        try:
            GLib.spawn_async(argv, flags=GLib.SpawnFlags.SEARCH_PATH)
        except GLib.Error as e:
            print(f"enclave-start: {argv[0]}: {e.message}", file=sys.stderr)

    def _show_power(self, _b):
        self.power_pop.popup()

    # pin / unpin (right-click)
    def _context_popover(self, widget, app):
        pop = Gtk.Popover.new(widget)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        items = []
        if app.id in self.pins:
            items.append(("Unpin from Start", lambda: self._unpin(app.id)))
            if self.pins.index(app.id) > 0:
                items.append(("Move to front", lambda: self._move_front(app.id)))
        else:
            items.append(("Pin to Start", lambda: self._pin(app.id)))
        for text, fn in items:
            b = Gtk.Button(label=text)
            b.get_child().set_xalign(0)
            b.connect("clicked", lambda _b, f=fn: (pop.popdown(), f()))
            box.pack_start(b, False, False, 0)
        box.show_all()
        pop.add(box)
        pop.popup()

    def _on_tile_press(self, widget, event, app):
        if event.button == 3:
            self._context_popover(widget, app)
            return True
        return False

    def _on_list_press(self, lst, event):
        if event.button != 3:
            return False
        row = lst.get_row_at_y(int(event.y))
        if row is not None and row.app is not None:
            lst.select_row(row)
            self._context_popover(row, row.app)
            return True
        return False

    def _pin(self, aid):
        if aid not in self.pins:
            self.pins.append(aid)
            save_pins(self.pins)
            self._fill_pins()

    def _unpin(self, aid):
        if aid in self.pins:
            self.pins.remove(aid)
            save_pins(self.pins)
            self._fill_pins()

    def _move_front(self, aid):
        if aid in self.pins:
            self.pins.remove(aid)
            self.pins.insert(0, aid)
            save_pins(self.pins)
            self._fill_pins()

    # --- show / hide -------------------------------------------------------
    def show_page(self, name, keep_search=False):
        if not keep_search and self.search.get_text():
            self.search.set_text("")
        self.stack.set_visible_child_name(name)
        if name == "all":
            self._select_first(self.all_list)

    def _place(self):
        display = Gdk.Display.get_default()
        seat = display.get_default_seat()
        mon = None
        if seat is not None and seat.get_pointer() is not None:
            _s, px, py = seat.get_pointer().get_position()
            mon = display.get_monitor_at_point(px, py)
        mon = mon or display.get_primary_monitor() or display.get_monitor(0)
        wa = mon.get_workarea()
        h = min(HEIGHT, wa.height - 24)
        self.set_size_request(WIDTH, h)
        self.resize(WIDTH, h)
        self.move(wa.x + (wa.width - WIDTH) // 2, wa.y + wa.height - h - 12)

    def show_menu(self):
        self.pins = load_pins()
        self._fill_pins()
        self.rec_expanded = False
        self.search.set_text("")
        self.stack.set_visible_child_name("home")
        self._place()
        self.revealer.set_reveal_child(False)
        self.show_all()
        self.search_empty.hide()
        self._fill_recommended()
        gdkwin = self.get_window()
        ts = GdkX11.x11_get_server_time(gdkwin) if isinstance(gdkwin, GdkX11.X11Window) else 0
        self.present_with_time(ts)
        self.search.grab_focus()
        GLib.idle_add(lambda: self.revealer.set_reveal_child(True) and False)

    def hide_menu(self):
        if self.get_visible():
            self.power_pop.popdown()
            self.hide()
            self._hidden_at = time.monotonic()

    def toggle(self):
        if self.get_visible():
            self.hide_menu()
        elif time.monotonic() - self._hidden_at < 0.35:
            # The click on the Start button that just took focus away (and so
            # closed the menu) must not immediately reopen it.
            return
        else:
            self.show_menu()

    def _on_focus_out(self, *_):
        # Popovers live inside this window, so they don't count as leaving.
        GLib.timeout_add(80, self._hide_if_unfocused)
        return False

    def _hide_if_unfocused(self):
        if self.get_visible() and not self.is_active():
            self.hide_menu()
        return False

    def _on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
            elif self.stack.get_visible_child_name() != "home":
                self.show_page("home")
            else:
                self.hide_menu()
            return True
        if not self.search.has_focus() and event.string and event.string.isprintable():
            self.search.grab_focus_without_selecting()
            return self.search.event(event)
        return False

    # --- look ----------------------------------------------------------------
    def _update_solid(self):
        ctx = self.frame.get_style_context()
        if self.get_screen().is_composited():
            ctx.remove_class("solid")
        else:
            ctx.add_class("solid")
        self.queue_draw()

    @staticmethod
    def _clear_background(_w, cr):
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        return False


class StartApp(Gtk.Application):
    def __init__(self, background):
        super().__init__(application_id=APP_ID)
        self.background = background
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.win = StartMenu(self)
        toggle = Gio.SimpleAction.new("toggle", None)
        toggle.connect("activate", lambda *_: self.win.toggle())
        self.add_action(toggle)
        for name, fn in (("show", lambda: self.win.show_menu()), ("hide", lambda: self.win.hide_menu())):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", lambda *_a, f=fn: f())
            self.add_action(act)
        self.hold()  # stay resident while hidden

    def do_activate(self):
        if self.background:
            self.background = False  # the launch itself; later activations toggle
            return
        self.win.toggle()


def main():
    background = "--background" in sys.argv[1:]
    app = StartApp(background)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
