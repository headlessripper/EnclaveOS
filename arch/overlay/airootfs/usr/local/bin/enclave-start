#!/usr/bin/env python3
# Enclave OS — the Start menu.
#
# A Windows-11-style Start menu with Enclave/macOS polish:
#   * search box on top — searches apps, settings and your files as you type
#   * Pinned: an icon grid you can rearrange (right-click: unpin / move to front)
#   * Recommended: recently opened files and recently added apps
#     (a "Get started" set on a fresh system)
#   * All apps: A–Z list with letter headings
#   * bottom row: you (picture + name), Settings, Power (lock / sleep / sign out /
#     restart / shut down)
#
# It runs as a single background instance (started at login with --background)
# so opening it is instant. The Start button and the Windows key call
# enclave-start-toggle, which asks the running instance over D-Bus to toggle.
#
# Which apps appear is decided by the same de-clutter rules the rest of the
# desktop uses: /usr/share/enclave/menus/enclave-applications.menu. Individual
# settings panels are hidden from the list but still found by search.
#
# Deps: python-gobject, python-cairo, gtk3.
import json
import os
import pwd
import sys
import threading
import time
import xml.etree.ElementTree as ET

import cairo
import gi
from gi.repository import GLib

GLib.set_prgname("enclave-start")  # WM_CLASS "enclave-start" / "Enclave-start"
GLib.set_application_name("Start")

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkX11", "3.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GdkPixbuf, GdkX11, Gio, Gtk, Pango, PangoCairo  # noqa: E402

APP_ID = "os.enclave.Start"
MENU_FILE = "/usr/share/enclave/menus/enclave-applications.menu"
DEFAULTS_FILE = "/usr/share/enclave/start-defaults.json"
CONF_FILE = os.path.join(GLib.get_user_config_dir(), "enclave", "start.json")

WIDTH, HEIGHT = 660, 720
PIN_COLS = 6
REC_SHOW, REC_MORE = 6, 16
ICON_TILE, ICON_ROW = 36, 26
ACCENT = "#ff6b1a"

SETTINGS_CATS = {
    "Settings", "X-XFCE-SettingsDialog", "X-XFCE-HardwareSettings",
    "X-XFCE-PersonalSettings", "X-XFCE-SystemSettings", "X-GNOME-NetworkSettings",
}
FALLBACK_PINS = [
    "zen.desktop", "org.mozilla.Thunderbird.desktop", "thunar.desktop",
    "xfce-settings-manager.desktop",
]
GET_STARTED = [
    ("enclave-install.desktop", "Install Enclave OS on this PC"),
    ("zen.desktop", "Browse the web"),
    ("xfce-backdrop-settings.desktop", "Change your wallpaper"),
    ("xfce-settings-manager.desktop", "Make Enclave yours"),
    ("enclave-assistant.desktop", "Ask the Enclave Assistant"),
    ("org.mozilla.Thunderbird.desktop", "Set up your email"),
]
# Raw configuration tools that would only confuse in search.
SEARCH_HIDDEN = {"xfce4-settings-editor.desktop"}
FILE_ROOTS = ["Desktop", "Documents", "Downloads", "Pictures", "Music", "Videos"]

