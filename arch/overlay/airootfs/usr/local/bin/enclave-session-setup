#!/usr/bin/env bash
# Enclave OS — per-login session touch-ups (runs from autostart, idempotent).
#
# Desktop launchers: Xfce only runs a .desktop file on the desktop without an
# "Untrusted application launcher" prompt if it is executable AND carries a
# checksum in its gvfs metadata. Files copied from /etc/skel can't carry that
# metadata, so mark Enclave's own launchers trusted here.
set -u

DESKTOP_DIR="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
for f in "$DESKTOP_DIR"/enclave-*.desktop; do
  [ -f "$f" ] || continue
  chmod u+x "$f" 2>/dev/null
  sum="$(sha256sum "$f" | cut -d' ' -f1)"
  gio set -t string "$f" metadata::xfce-exe-checksum "$sum" 2>/dev/null || true
done
exit 0
