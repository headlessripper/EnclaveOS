#!/usr/bin/env bash
# Enclave OS — start the compositor with fallbacks, so the desktop always has
# shadows / translucency even where picom's GLX backend can't run.
#   1. picom, GLX backend (blur, rounded corners)      ~/.config/picom.conf
#   2. picom, xrender backend (no blur)                 if (1) exits early
#   3. xfwm4's built-in compositor                      if picom can't run at all
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/picom.conf"
LOG="${XDG_RUNTIME_DIR:-/tmp}/enclave-compositor.log"

run_picom() { # extra picom args...
  local start
  start=$(date +%s)
  picom --config "$CONF" "$@" >>"$LOG" 2>&1
  local rc=$?
  # A picom that ran for a while and then exited (e.g. the session is ending)
  # is not a startup failure.
  if [ $(( $(date +%s) - start )) -ge 15 ]; then
    exit "$rc"
  fi
  return "$rc"
}

pkill -u "$(id -u)" -x picom 2>/dev/null

if command -v picom >/dev/null 2>&1 && [ -f "$CONF" ]; then
  echo "[enclave-compositor] picom (glx)" >>"$LOG"
  run_picom
  echo "[enclave-compositor] glx failed; picom (xrender, no blur)" >>"$LOG"
  run_picom --backend xrender --blur-method none
fi

echo "[enclave-compositor] picom unavailable; using xfwm4's compositor" >>"$LOG"
xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null \
  || xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s true
