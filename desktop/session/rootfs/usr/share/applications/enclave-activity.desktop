[Desktop Entry]
Type=Application
Name=Activity
GenericName=Task Manager
Comment=See what's running and end apps that misbehave
Exec=enclave-settings --page activity
Icon=enclave-task-manager
Terminal=false
StartupNotify=true
StartupWMClass=enclave-settings
Categories=System;Monitor;
Keywords=task;manager;processes;cpu;memory;kill;end;system;monitor;
