#!/bin/sh
# Enclave OS — keep the shell alive: a crash restarts it without logging
# the user out (it exits 0 only on purpose, e.g. `--command quit`).
n=0
while :; do
  start=$(date +%s)
  env -u QT_QPA_PLATFORMTHEME enclave-shell && exit 0
  # Give up after repeated instant crashes so a broken build can't spin.
  if [ $(( $(date +%s) - start )) -lt 5 ]; then n=$((n + 1)); else n=0; fi
  [ "$n" -ge 5 ] && exit 1
  sleep 1
done
